{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Journal: Vorlage mit Top 3 heute (falls fehlt)",
      "type": "shell",
      "command": "py src/update_daily_journal.py --stub-with-ranking-if-missing",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "echo": false,
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Team-Manager: Dienst starten",
      "type": "process",
      "command": "${workspaceFolder}/team-manager/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "team_manager",
        "--skip-if-running",
        "--open-browser"
      ],
      "osx": {
        "command": "${workspaceFolder}/team-manager/.venv/bin/python"
      },
      "options": {
        "cwd": "${workspaceFolder}/team-manager"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "echo": false,
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
